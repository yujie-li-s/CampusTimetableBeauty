page{
  background:#fff;
}
.container{
  width:100%;
  height:100vh;
  display:flex;
  flex-direction:column;
  box-sizing: border-box;
}

.header-top{
  display:flex;
  justify-content:space-between;
  padding:24rpx 30rpx;
  align-items:center;
  position:relative;
}
.week-select{
  font-size:34rpx;
}
.menu-icon{
  font-size:40rpx;
}
.menu-panel{
  position:absolute;
  top:80rpx;
  right:20rpx;
  background:#fff;
  box-shadow:0 0 12rpx #ccc;
  border-radius:12rpx;
  z-index:99;
}
.menu-item{
  padding:24rpx 40rpx;
  font-size:32rpx;
}

/* ==========星期表头行========== */
.week-header-row{
  display:flex;
  flex-shrink:0;
}
.time-col-placeholder{
  width:120rpx;
  flex-shrink:0;
  border-right:1rpx solid #eee;
  padding:16rpx 4rpx;
  box-sizing: border-box;
}
.week-cell{
  flex:1;
  text-align:center;
  font-size:26rpx;
  color:#666;
  padding:16rpx 0;
  border-right:1rpx solid #eee;
  box-sizing: border-box;
}

.scroll-lesson-area{
  flex:1;
  height:0;
}
.lesson-table{
  width:100%;
}
.lesson-row{
  display:flex;
}
.time-cell{
  width:120rpx;
  flex-shrink:0;
  text-align:center;
  font-size:24rpx;
  color:#666;
  padding:16rpx 4rpx;
  border-right:1rpx solid #eee;
  border-bottom:1rpx solid #eee;
  box-sizing: border-box;
}
.num{
  font-size:30rpx;
  margin-bottom:8rpx;
}
.time{
  line-height:1.4;
}
.day-cell{
  flex:1;
  min-height:140rpx;
  border-right:1rpx solid #eee;
  border-bottom:1rpx solid #eee;
  padding:16rpx 0;
  box-sizing: border-box;
}

/*周选择弹窗*/
.week-mask{
  position:fixed;
  top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,0.4);
  z-index:100;
}
.week-wrap{
  background:#fff;
  padding:30rpx;
  margin-top:120rpx;
  display:grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap:20rpx;
}
.week-item{
  text-align:center;
  padding:24rpx 0;
  border:1rpx solid #eee;
  border-radius:8rpx;
}
.week-item.active{
  background:#007aff;
  color:#ffffff;
}
/*时间段隔断加深横线：4课结束、8课结束的底边框 */
.divider-row .time-cell{
  border-bottom: 3rpx solid #bbbbbb !important;
}
.divider-row .day-cell{
  border-bottom: 3rpx solid #bbbbbb !important;
}
/* 课程块样式 */
.course-block {
  background: #4c8bf5;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 4rpx 6rpx;
  margin: 2rpx 4rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.room {
  font-size: 18rpx;
  opacity: 0.8;
}
