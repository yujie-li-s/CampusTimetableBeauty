<view class="container">
  <!-- 顶部 -->
  <view class="header-top">
    <view class="week-select" bindtap="toggleWeekPopup">{{weekTitle}} ∨</view>
    <view class="share-mode-tip" wx:if="{{isSharedMode}}">📤 查看好友课表</view>
    <view class="menu-icon" bindtap="showMenu">☰</view>
  </view>

  <!-- 菜单 -->
  <view wx:if="{{showMenuPanel}}" class="menu-panel">
    <view class="menu-item" bindtap="goSetting">设置</view>
    <view class="menu-item" bindtap="importData">导入Excel</view>
    <button class="menu-item share-btn" open-type="share">分享本周课表</button>
    <view class="menu-item" wx:if="{{isSharedMode}}" bindtap="exitShareMode">返回我的课表</view>
  </view>

  <!-- 周选择弹窗 -->
  <view wx:if="{{showWeekSelect}}" class="week-mask" bindtap="closeWeekPopup">
    <view class="week-wrap" catchtap="stop">
      <block wx:for="{{weekList}}" wx:key="index">
        <view class="week-item {{item.active?'active':''}}" bindtap="selectWeek" data-week="{{item.val}}">
          {{item.label}}
        </view>
      </block>
    </view>
  </view>

  <!-- 星期表头 -->
  <view class="week-header-row">
    <view class="time-col-placeholder"></view>
    <block wx:for="{{weekDays}}" wx:key="index">
      <view class="week-cell">
        <text class="week-day">{{item.week}}</text>
        <text class="week-date">{{item.dateShort}}</text>
      </view>
    </block>
  </view>

  <!-- 课表主体 -->
  <scroll-view scroll-y class="scroll-lesson-area">
    <view class="lesson-grid" style="grid-template-rows: repeat({{timeSlots.length}}, 100rpx);">
      <block wx:for="{{timeSlots}}" wx:for-item="slot" wx:key="no">
        <view class="time-cell" style="grid-row: {{slot.no}};">
          <view class="num">{{slot.no}}</view>
          <view class="time">{{slot.start}}</view>
          <view class="time">{{slot.end}}</view>
        </view>
      </block>

      <block wx:for="{{timeSlots}}" wx:for-item="slot" wx:key="no">
        <block wx:for="{{weekDays}}" wx:for-item="day" wx:for-index="dayIdx" wx:key="dayIdx">
          <view class="grid-cell" style="grid-row: {{slot.no}}; grid-column: {{dayIdx + 2}};" bindtap="tapCell" data-day="{{dayIdx}}" data-slot="{{slot.no}}">
          </view>
        </block>
      </block>

      <block wx:for="{{mergedCourses}}" wx:for-item="course" wx:key="id">
        <view class="course-card" style="grid-row: {{course.slotStart}} / {{course.slotEnd + 1}}; grid-column: {{course.day + 2}}; background-color: {{course.color || '#e8f5e9'}};" bindtap="tapCourse" data-course="{{course}}">
          <view class="course-name">{{course.name}}</view>
          <view class="course-room" wx:if="{{course.room}}">{{course.room}}</view>
          <view class="course-teacher" wx:if="{{course.teacher}}">{{course.teacher}}</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 课程弹窗【正确】 -->
  <course-modal
    show="{{modalShow}}"
    edit-data="{{editCourseData}}"
    bind:closeModal="closeModal"
    bind:confirm="confirmCourse"
    bind:delete="deleteCourseById"
  />

</view>
