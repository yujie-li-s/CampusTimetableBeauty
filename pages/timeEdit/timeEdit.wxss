.page {
  background: #ffffff;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.back {
  font-size: 36rpx;
  color: #007aff;
}
.title {
  font-size: 34rpx;
  font-weight: 500;
}
.clear {
  color: #007aff;
  font-size: 32rpx;
}

.group {
  margin-top: 20rpx;
}
.group-title {
  padding: 20rpx 30rpx;
  color: #888;
  background: #f5f6f7;
  font-size: 30rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}
.name {
  font-size: 34rpx;
}
.time {
  color: #666;
  font-size: 32rpx;
}
.arrow {
  color: #999;
}

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
}
.popup {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}
.pop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.pop-cancel {
  color: #007aff;
  font-size: 32rpx;
}
.pop-title {
  font-size: 34rpx;
  font-weight: 500;
}
.pop-ok {
  color: #007aff;
  font-size: 32rpx;
}

.pick-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  background: #fff;
}
.picker-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.picker-group .label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.picker-value {
  font-size: 40rpx;
  color: #333;
  padding: 20rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  width: 160rpx;
  text-align: center;
}
.to {
  margin: 0 30rpx;
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}

.save-btn {
  margin: 40rpx 30rpx;
  background: #0091ff;
  color: #fff;
  text-align: center;
  border-radius: 12rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
}