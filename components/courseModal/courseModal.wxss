/* ===== 遮罩层 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
  /* 模糊兼容，不支持的设备自动降级 */
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
}

/* ===== 弹窗主体 ===== */
.modal {
  background: #ffffff;
  border-radius: 32rpx;
  width: 92%;
  max-width: 640rpx;
  max-height: 85vh;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: fadeInUp 0.25s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 头部 ===== */
.modal-header {
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  line-height: 1.4;
}

.modal-header .subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
}

/* ===== 表单主体 ===== */
.form-body {
  margin-bottom: 8rpx;
}

/* 分组 */
.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A90D9;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A90D9;
}

/* 字段行 */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 18rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

/* ===== 输入框 ===== */
.ipt {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  transition: border-color 0.2s, background-color 0.2s;
  width: 100%;
  box-sizing: border-box;
  min-height: 76rpx;
  line-height: 1.4;
}

.ipt:focus {
  border-color: #4A90D9;
  background: #ffffff;
}

/* 自定义 placeholder 样式 */
.placeholder-style {
  font-size: 26rpx;
  color: #b0b0b0;
}

/* ===== 选择器 ===== */
.picker-value {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 18rpx 64rpx 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  position: relative;
}

.picker-value::after {
  content: '▾';
  position: absolute;
  right: 24rpx;
  color: #999;
  font-size: 28rpx;
  pointer-events: none;
}

/* ===== 底部按钮 ===== */
.btns {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  gap: 16rpx;
}

/* 重置小程序button默认样式（重要！） */
.btns button {
  margin: 0 !important;
  border: none !important;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  transition: opacity 0.2s;
}

/* 删除按钮（靠左，margin‑right:auto把剩余空间挤到右边） */
.btns .btn-delete {
  background: #ff4757;
  color: #fff;
  margin-right: auto !important;
  padding: 16rpx 36rpx;
}

.btns .btn-delete:active {
  background: #e0313f;
  opacity: 0.85;
}

/* 取消按钮 */
.btns .btn-cancel {
  background: #f1f2f6;
  color: #666;
  padding: 16rpx 36rpx;
}

.btns .btn-cancel:active {
  background: #e5e6eb;
  opacity: 0.85;
}

/* 确认/保存按钮 */
.btns .btn-confirm {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff;
  padding: 16rpx 48rpx;
}

.btns .btn-confirm:active {
  opacity: 0.85;
}

/* ===== 滚动条美化 ===== */
.modal::-webkit-scrollbar {
  width: 4rpx;
}

.modal::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 4rpx;
}

.modal::-webkit-scrollbar-track {
  background: transparent;
}
